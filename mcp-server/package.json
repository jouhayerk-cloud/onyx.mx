{
  "name": "onyx-mx-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "MCP server for Onyx.mx warehouse inventory, finance, and logistics management",
  "main": "dist/index.js",
  "bin": {
    "onyx-mx-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:@supabase/supabase-js --external:dotenv --external:zod --packages=external",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.97.0",
    "dotenv": "^16.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.24.0",
    "@types/node": "^22.0.0"
  }
}
