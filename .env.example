# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed.

# Every variable the app reads must be prefixed VITE_ — Vite does not inline any
# other name, so an unprefixed key is silently undefined at runtime.

# Google Gemini
VITE_GEMINI_API_KEY=your-gemini-api-key

# Supabase
VITE_SUPABASE_URL=your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_OFFLINE_KEY=your-offline-key

# Google Sheets upload webhook (Apps Script exec URL)
VITE_GOOGLE_SHEETS_WEBHOOK=your-webhook-url

# NOTE: VITE_CYPHER_KEY has been retired. The cost cypher now runs in the
# database (public.onyx_cypher) and the app reads the stored book_aq_code /
# book_land_code / book_barcode columns. Never reintroduce a cypher key here —
# every VITE_ variable is inlined into the public bundle.
