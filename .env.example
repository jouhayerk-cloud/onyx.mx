# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed.

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Supabase
VITE_SUPABASE_URL=your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Price obfuscation cypher key
# 10-character string. Each character position (0–9) maps to the display letter for that digit.
# Example format: DMOXHELFAN  (position 0 = 'D', position 1 = 'M', etc.)
# Contact the project owner for the production value.
VITE_CYPHER_KEY=XXXXXXXXXX
